      "parameters": {
        "jsCode": "const aiResponse = $input.first().json.output;\n\n\nif (!aiResponse) {\n    return [{ json: { error: 'No hay respuesta disponible' } }];\n}\nelse {\n  try{\n     const cleanedAiResponse = aiResponse.trim().replace(/^```json\\n?/, '').replace(/\\n?```$/, '');\n     const parsedAiResponse= JSON.parse(cleanedAiResponse);\n     const events = Array.isArray(parsedAiResponse) ? parsedAiResponse : [parsedAiResponse];\n\n     return events.map(evento => ({\n       json: {\n         nombre_evento:     evento.nombre_evento     ?? null,\n         fechaThora_inicio: evento.fechaThora_inicio ?? null,\n         fechaThora_fin:    evento.fechaThora_fin    ?? null,\n         participantes:     evento.participantes     ?? null,\n         error: (!evento.fechaThora_inicio || !evento.fechaThora_fin) ? 'Fecha(s) no disponible(s)' : ''\n       }\n     }));\n  }\n  catch{\n    return [{ json: { error: 'Parseo no disponible' } }];\n  }\n}\n"
      },
