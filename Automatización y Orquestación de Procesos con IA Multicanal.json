    {
      "parameters": {
        "jsCode": "const email = $input.first().json;\n\nif (!email.Subject && email.snippet.length <= 10 ){\n\n  return {\n    json: { isValid: false}\n  }\n}\nelse {\n  const cleanMail = {\n     messageId : email.id,\n     from : email.From,\n     subject : email.Subject.trim().slice(0,500) || '',\n     snippet : email.snippet.trim().slice(0,5000),\n     receivedAt : email.internalDate || Date.now()\n     \n  }\n  \n  const hashInput = `${cleanMail.from}|${cleanMail.subject}|${cleanMail.snippet.slice(0, 500)}`;\n  const emailHash = { \n    hash : hashInput.split('').reduce((acc, char) => (acc * 31 + char.charCodeAt(0)) & 0xffffffff, 0).toString(16).padStart(8, '0'),\n    processedAt : Date.now() \n  }\n  \n  return [{\n    json: {\n      emailHash,\n      cleanMail,\n      isValid: true\n      }\n  }];\n}\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        0
      ],
      "id": "7b1252f8-5d70-44d9-ad21-167dc7d22d46",
