      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const datos = {\n    summary: item.json.summary,\n    start: item.json.start.date,\n  }\n  const [tarea, responsable] = datos.summary.split(' - ');\n  \n  const mensaje = `TAREA AGENDADA📌: ${tarea}\\n\\t-responsable:${responsable}\\n\\t-vencimiento:${datos.start}`\n\n  return {\n    json: { mensaje }\n  }\n});"
      },
