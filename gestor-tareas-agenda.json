    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const input = item.json;\n\n  // --- Raw inputs ---\n  const rawTarea = input['Tarea'] ?? '';\n  const rawResponsable = input['Responsable'] ?? '';\n  const rawFecha = input['Fecha  AAAA-MM-DD'] ?? '';\n  const rawEstado = input['Estado            pen | lis | age'] ?? '';\n\n  const ESTADOS_VALIDOS = ['pendiente', 'lista', 'agendada'];\n\n  // --- Validaciones ---\n  const tareaValida = rawTarea.trim() !== '';\n  const responsable = (rawResponsable.trim() === '' ? 'indefinido' : rawResponsable.trim()).toUpperCase();\n  const estadoNorm = rawEstado.trim().toLowerCase();\n  const estadoValido = ESTADOS_VALIDOS.includes(estadoNorm);\n  const columna = input.row_number;\n\n  // Validación de fecha\n  const fechaRegex = /^\\d{4}-\\d{2}-\\d{2}$/;\n  let fechaValida = false;\n  let fechaObj = null;\n  if (fechaRegex.test(rawFecha.trim())) {\n    fechaObj = new Date(rawFecha.trim() + 'T00:00:00');\n    fechaValida = !isNaN(fechaObj.getTime());\n  }\n\n  // Fecha +1\n  let fechaFin = null;\n  if (fechaValida) {\n    fechaFin = new Date(fechaObj.getTime() + 86400000).toISOString().slice(0, 10);\n  }\n\n  let error = (!tareaValida || !fechaValida || !estadoValido);\n\n  return {\n    json: {\n      summary: `${rawTarea.trim()} - ${responsable}`,\n      start: rawFecha.trim(),\n      end: fechaFin,\n      error: error,\n      _sheetsData:{\n        columna,\n        tarea: tareaValida ? rawTarea : 'tarea vacía',\n        responsable,\n        fecha: fechaValida ? rawFecha : `fecha inválida (${rawFecha})`,\n        estado: estadoValido ? estadoNorm : `estado inválido (${rawEstado})`,\n        procesada: true,\n      }\n    }\n  };\n});"
      },
